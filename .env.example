# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Keep comments on their own lines: `KEY=  # note` would set KEY to "# note".
GOOGLE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Use https:// for Home Assistant unless it is on a trusted LAN: HA_TOKEN is sent as a
# Bearer header and travels in cleartext over plain http://.
HA_URL=http://homeassistant.local:8123
# Home Assistant long-lived access token
HA_TOKEN=
HA_SONOS_ENTITY=media_player.living_room
# Optional: override the detected LAN IP used for Sonos playback
VP_SERVE_HOST=
# 0 = random free port
VP_SERVE_PORT=0
VP_VOICES_DIR=voices
VP_CACHE_DIR=.vp_cache
